{
  "name": "pixelpet",
  "version": "0.1.0",
  "description": "A tiny pixel pet that lives on your Mac desktop.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.sahithya.pixelpet",
    "productName": "PixelPet",
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg"]
    }
  }
}
